set_option maxHeartbeats 0
namespace ActualCarrierReplay
def program : (church0 : Type) → church0 → Int → ((church1 : Type) → (church0 → church1 → church1) → church1 → church1) → church0 :=
  fun A d =>
  (fun step init n xs => xs (Int → A) step init n) (fun a a_1 a_2 => BehaviorPartialNumeric.intCase A a_2 d a a_1)
