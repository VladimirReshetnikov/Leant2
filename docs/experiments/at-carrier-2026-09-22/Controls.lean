namespace BehaviorPartialNumeric
def intCase : ∀ R : Type, Int → R → R → (Int → R) → R := fun _ n negative zero positive => if n < 0 then negative else if n = 0 then zero else positive (n - 1)
end BehaviorPartialNumeric
namespace BehaviorPartialOracle
def head {A : Type} (d : A) (xs : List A) : A := match xs with | [] => d | x :: _ => x
def last {A : Type} (d : A) (xs : List A) : A := xs.foldl (fun _ x => x) d
def indexOr {A : Type} (d : A) (n : Int) : List A → A
  | [] => d
  | x :: xs => if n < 0 then d else if n = 0 then x else indexOr d (n - 1) xs
def foldl1 {A : Type} (d : A) (step : A → A → A) (xs : List A) : A := match xs with | [] => d | x :: rest => rest.foldl step x
def foldr1 {A : Type} (d : A) (step : A → A → A) (xs : List A) : A := (xs.foldr (fun x rest => some (rest.elim x (step x))) (none : Option A)).getD d
end BehaviorPartialOracle
namespace BehaviorPartialControl
def witness_at : (∀ (church0 : Type), (church0 → (Int → ((∀ (church1 : Type), ((church0 → (church1 → church1)) → (church1 → church1))) → church0)))) := fun A d n xs => BehaviorPartialOracle.indexOr d n (BehaviorPartial.dec xs)
theorem witness_at_passes : BehaviorPartial.check_at (BehaviorPartialControl.witness_at) = true := by decide
def primitiveWitness_at : (∀ (church0 : Type), (church0 → (Int → ((∀ (church1 : Type), ((church0 → (church1 → church1)) → (church1 → church1))) → church0)))) := fun A d n xs => xs (Int → A) (fun x rest i => BehaviorPartialNumeric.intCase A i d x (fun previous => rest previous)) (fun _ => d) n
theorem primitiveWitness_at_passes : BehaviorPartial.check_at (BehaviorPartialControl.primitiveWitness_at) = true := by decide
def wrong_at_always_default : (∀ (church0 : Type), (church0 → (Int → ((∀ (church1 : Type), ((church0 → (church1 → church1)) → (church1 → church1))) → church0)))) := fun _ d _ _ => d
theorem wrong_at_always_default_rejected : BehaviorPartial.check_at BehaviorPartialControl.wrong_at_always_default = false := by decide
def wrong_at_ignores_index : (∀ (church0 : Type), (church0 → (Int → ((∀ (church1 : Type), ((church0 → (church1 → church1)) → (church1 → church1))) → church0)))) := fun A d _ xs => BehaviorPartialOracle.head d (BehaviorPartial.dec xs)
theorem wrong_at_ignores_index_rejected : BehaviorPartial.check_at BehaviorPartialControl.wrong_at_ignores_index = false := by decide
end BehaviorPartialControl
